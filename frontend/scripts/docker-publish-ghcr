#!/usr/bin/env bash

set -euo pipefail

# --- config ---
REPO="ghcr.io/definitelynotsimon13/trichter-monorepo/frontend"

# --- derive values ---
SHA="$(git rev-parse --short HEAD)"

IMAGE_SHA="${REPO}:${SHA}"
IMAGE_LATEST="${REPO}:latest"

echo "Building image:"
echo "  SHA tag:     ${IMAGE_SHA}"
echo "  latest tag:  ${IMAGE_LATEST}"
echo

# --- build ---
docker build \
  --build-arg VITE_BUILD_ID="${SHA}" \
  -t "${IMAGE_SHA}" \
  -t "${IMAGE_LATEST}" \
  .

# --- push ---
echo "Pushing ${IMAGE_SHA}"
docker push "${IMAGE_SHA}"

echo "Pushing ${IMAGE_LATEST}"
docker push "${IMAGE_LATEST}"

echo
echo "Done."
