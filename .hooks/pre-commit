#!/usr/bin/env bash
set -euo pipefail

GIT_ROOT="$(git rev-parse --show-toplevel)"
cd "$GIT_ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"

if [[ -z "$STAGED" ]]; then
  exit 0
fi

# --- output helpers -----------------------------------------------------------

info() {
  printf '\033[1;34m[info]\033[0m %s\n' "$*"
}

ok() {
  printf '\033[1;32m[ok]\033[0m %s\n' "$*"
}

warn() {
  printf '\033[1;33m[warn]\033[0m %s\n' "$*"
}

err() {
  printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2
}

section() {
  printf '\n\033[1;36m==> %s\033[0m\n' "$*"
}

# file groups

DEPLOY_STAGED="$(printf '%s\n' "$STAGED" | grep "^deployment/" || true)"
FRONTEND_STAGED="$(printf '%s\n' "$STAGED" | grep '^frontend/' || true)"
BACKEND_STAGED="$(printf '%s\n' "$STAGED" | grep '^backend/' || true)"

# deployment: encrypt secret yaml files

if [[ -n "$DEPLOY_STAGED" ]]; then
  SECRET_FILES="$(printf '%s\n' "$DEPLOY_STAGED" | grep -E '\.secret\.ya?ml$' || true)"

  if [[ -n "$SECRET_FILES" ]]; then
    section "Checking deployment secret files"

    FAILED=0
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      abs_file="$GIT_ROOT/$file"

      info "Ensuring SOPS encryption for $file"

      if [[ "$(yq '.sops != null' "$abs_file")" != "true" ]]; then
        warn "$file is not encrypted yet, encrypting now"
        sops --config "deployment/.sops.yaml" --encrypt --in-place "$abs_file"
        git add "$abs_file"
      fi

      if [[ "$(yq '.sops != null' "$abs_file")" != "true" ]]; then
        err "$file is still not encrypted with SOPS"
        FAILED=1
      else
        ok "$file is encrypted"
      fi
    done <<< "$SECRET_FILES"

    [[ "$FAILED" -eq 0 ]] || exit 1
  fi

  YAML_FILES="$(printf '%s\n' "$DEPLOY_STAGED" | grep -E '\.ya?ml$' | grep -vE '\.secret\.ya?ml$' || true)"

  if [[ -n "$YAML_FILES" ]]; then
    section "Formatting deployment YAML"

    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      abs_file="$GIT_ROOT/$file"
      info "Formatting $file"
      yamlfmt "$abs_file"
      git add "$abs_file"
      ok "Formatted $file"
    done <<< "$YAML_FILES"
  fi
fi

# frontend formatting

if [[ -n "$FRONTEND_STAGED" ]]; then
  section "Formatting frontend"

  if command -v just >/dev/null 2>&1; then
    just fmt-frontend
    git add frontend
    ok "Frontend formatting complete"
  else
    err "'just' is not installed, cannot run fmt-frontend"
    exit 1
  fi
fi

# backend formatting

if [[ -n "$BACKEND_STAGED" ]]; then
  section "Formatting backend"

  if command -v just >/dev/null 2>&1; then
    just fmt-backend
    git add backend
    ok "Backend formatting complete"
  else
    err "'just' is not installed, cannot run fmt-backend"
    exit 1
  fi
fi

section "Pre-commit checks complete"
