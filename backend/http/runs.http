@runId = 0787de56-ca0d-4109-b579-70122a73867b
@userId = IN98sFyCl1X4jnSAeHu6H0pqdf3glTA1

### Get all runs
GET {{baseUrl}}/api/v2/runs?page=0&size=10&sort=createdAt,desc
Accept: application/json

### Get all runs with custom sorting
GET {{baseUrl}}/api/v2/runs?page=0&size=5&sort=rate,asc
Accept: application/json

### Get single run by ID
GET {{baseUrl}}/api/v2/runs/{{runId}}
Accept: application/json

### Get runs by user
GET {{baseUrl}}/api/v2/users/{{userId}}/runs?page=0&size=10&sort=createdAt,desc
Accept: application/json

### Create run
POST {{baseUrl}}/api/v2/runs
Content-Type: application/json
Accept: application/json

{
  "userId": "{{userId}}",
  "rate": 5.13,
  "volume": 0.42,
  "duration": 4.96
}

> {%
    client.global.set("runId", response.body.id);
%}

### Create run (minimal realistic example)
POST {{baseUrl}}/api/v2/runs
Content-Type: application/json
Accept: application/json

{
  "userId": "{{userId}}",
  "rate": 6.2,
  "volume": 1.1,
  "duration": 5.0
}

> {%
    client.global.set("newRunId", response.body.id);
%}

### Upload image for run
PUT {{baseUrl}}/api/v2/runs/{{newRunId}}/image
Accept: application/json
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./images/placeholder.jpg
--WebAppBoundary--

### Stream image for run
GET {{baseUrl}}/api/v2/runs/{{newRunId}}/image
Accept: image/*

### Get signed URL for run image
GET {{baseUrl}}/api/v2/runs/{{newRunId}}/image/signed-url
Accept: application/json
